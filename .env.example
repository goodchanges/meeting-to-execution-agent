APP_ENV=development
DB_PATH=data/meetflow.sqlite
PUBLIC_URL=http://localhost:8000
# Explicitly set demo for the synthetic sample workflow.
AI_MODE=demo
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# DeepSeek is available with AI_PROVIDER=deepseek.
LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_OUTPUT_FORMAT=json_schema
SCHEDULER_ENABLED=true
# SECRET_KEY and HTTPS PUBLIC_URL are required in staging/production.
# CORS_ORIGINS=["https://meetflow.example.com"]
# TRUSTED_PROXIES=["127.0.0.1"]

GITHUB_REPOSITORY=
GITHUB_TOKEN=

