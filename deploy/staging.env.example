APP_ENV=staging
PUBLIC_URL=https://staging.meetflow.example.com
SECRET_KEY=
# Add the actual TLS proxy source IP as seen by MeetFlow.
TRUSTED_PROXIES=[]
CORS_ORIGINS=[]
AI_MODE=live
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# DeepSeek is available with AI_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
DEEPSEEK_OUTPUT_FORMAT=json_schema
# Use a distinct single-repo token against a private staging/test repository.
GITHUB_REPOSITORY=
GITHUB_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
METRICS_TOKEN=
BACKUP_RETAIN=14
