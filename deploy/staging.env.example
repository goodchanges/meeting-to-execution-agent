APP_ENV=staging
PUBLIC_URL=https://staging.meetflow.example.com
SECRET_KEY=
# Add the actual TLS proxy source IP as seen by MeetFlow.
TRUSTED_PROXIES=[]
CORS_ORIGINS=[]
AI_MODE=live
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# Use a distinct single-repo token against a private staging/test repository.
GITHUB_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
METRICS_TOKEN=
BACKUP_RETAIN=14
